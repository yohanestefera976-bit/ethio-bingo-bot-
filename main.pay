@bot.message_handler(func=lambda message: message.text == "ትክክለኛ 🎮 Play Bingo")
def play_bingo_menu(message):
  markup = types.InlineKeyboardMarkup(row_width=2)
  btn_stake10 = types.InlineKeyboardButton(
      "🎯 Bingo Stake 10 ETB", callback_data="bingo_10"
