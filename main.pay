if __name__ == "__main__":
  t = Thread(target=run_web)
  t.start()
  print("Bot and Web Server are running...")
  while True:
    try:
      bot.infinity_polling(timeout=60, long_polling_timeout=60)
    except Exception as e:
      print(f"Polling error: {e}")
      
