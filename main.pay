  btn_stake20 = types.InlineKeyboardButton(
      "🎯 Bingo Stake 20 ETB", callback_data="bingo_20"
  )
  markup.add(btn_stake10, btn_stake20)
  bot.send_message(
      message.chat.id,
      "👇 የሚፈልጉትን የቢንጎ መወራረጃ መጠን ይምረጡ፡",
      reply_markup=markup,
  )


@bot.callback_query_handler(func=lambda call: call.data.startswith("bingo_"))
def handle_bingo_game(call):
  user_id = call.from_user.id
  username = call.from_user.first_name
  stake_amount = float(call.data.split("_")[1])
  current_balance = get_or_create_user(user_id, username)

  if current_balance >= stake_amount:
    # 1. ውርርዱን መቀነስ
    update_balance(user_id, -stake_amount)

    # 2. የተጠቃሚውን የቢንጎ ካርድ ማመንጨት (25 ቁጥሮች)
    card = generate_bingo_card()

    # 3. ቦቱ የሚወጣቸው የድል ቁጥሮች (ለምሳሌ 10 ቁጥሮች በዘፈቀደ)
    drawn_numbers = random.sample(range(1, 75), 10)

    # 4. በካርዱ እና በወጡት ቁጥሮች መካከል ማመሳሰል (Matches)
    matches = [num for num in drawn_numbers if num in card]

    # 5. የማሸነፍ ሁኔታ (ቢያንስ 3 ቁጥሮች ከገቡ አሸናፊ ይሆናል)
    if len(matches) >= 3:
      payout = stake_amount * 3  # የቢንጎ 3 እጥፍ ሽልማት
      update_balance(user_id, payout)
      new_bal = get_or_create_user(user_id, username)

      card_str = "\n".join(str(card[i : i + 5]) for i in range(0, 25, 5))
      bot.answer_callback_query(call.id, "BINGO! You Won!")
      bot.send_message(
          call.message.chat.id,
          f"ርዕስ: 🎉 <b>ቢንጎ! አሸንፈዋል!</b> 🎉\n\nናካዎ የተሰጠው የቢንጎ ካርድ:\n<code>{card_str}</code>\n\n🎲"
          f" የወጡ ቁጥሮች: <code>{drawn_numbers}</code>\n🎯 የተገጠሙ (Matches):"
          f" <code>{matches}</code>\n💰 ያሸነፉት ሽልማት: <b>{payout} ብር</b>\n💳 አዲስ ቀሪ"
          f" ሒሳብዎ: <b>{new_bal} ብር</b>",
          parse_mode="HTML",
      )
    else:
      new_bal = get_or_create_user(user_id, username)
      card_str = "\n".join(str(card[i : i + 5]) for i in range(0, 25, 5))
      bot.answer_callback_query(call.id, "No Bingo, Try Again!")
      bot.send_message(
          call.message.chat.id,
          f"ርዕስ: ❌ <b>አልተሳካልዎትም (Not Bingo)</b>\n\nየእርስዎ ካርድ:\n<code>{card_str}</code>\n\n🎲"
          f" የወጡ ቁጥሮች: <code>{drawn_numbers}</code>\n📉 የተቀነሰው ውርርድ: <b>{stake_amount}"
          f" ብር</b>\n💳 ቀሪ ሒሳብዎ: <b>{new_bal} ብር</b>",
          parse_mode="HTML",
      )
  else:
    bot.answer_callback_query(call.id, "Insufficient balance!", show_alert=True)
    bot.send_message(
        call.message.chat.id,
        "❌ በቂ የኪስ ቦርሳ ሒሳብ የለዎትም! እባክዎ በመጀመሪያ <b>💳 ሒሳብ መሙላት</b>"
        " ይሙሉ (0993727789 - ዮሐንስ)።",
        parse_mode="HTML",
    )


